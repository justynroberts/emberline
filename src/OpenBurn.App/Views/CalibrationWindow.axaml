<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OpenBurn.App.Views.CalibrationWindow"
        Title="Calibrate camera"
        Width="960" Height="760"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgSunken}">

    <Grid RowDefinitions="Auto,*,Auto" Margin="14">

        <Border Grid.Row="0" Classes="panel focusIn" Margin="0,0,0,12">
            <StackPanel Spacing="6">
                <TextBlock Text="Click the four corners of the bed" FontSize="{DynamicResource FontMedium}" FontWeight="SemiBold" />
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource InkMuted}"
                           Text="In this order: rear-left, rear-right, front-right, front-left — the corners as they appear in the picture, going clockwise from the top left. Click precisely; every millimetre of error here becomes a millimetre of error in artwork placement." />
                <TextBlock x:Name="StepText" Classes="mono" Foreground="{DynamicResource Ember}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Classes="panel" Padding="6">
            <Canvas x:Name="ImageCanvas" Background="{DynamicResource BgSunken}" ClipToBounds="True" />
        </Border>

        <Border Grid.Row="2" Classes="panel focusInDelay1" Margin="0,12,0,0">
            <Grid ColumnDefinitions="Auto,220,Auto,*,Auto,Auto,Auto" ColumnSpacing="10">
                <TextBlock Grid.Column="0" Text="Lens" Classes="label" VerticalAlignment="Center" />
                <Slider Grid.Column="1" x:Name="LensSlider" Minimum="-0.4" Maximum="0.4" Value="0"
                        TickFrequency="0.02" VerticalAlignment="Center"
                        ToolTip.Tip="Straighten bowed edges from a wide-angle lens. Watch a straight edge in the picture while you drag." />
                <TextBlock Grid.Column="2" x:Name="LensValue" Classes="mono" VerticalAlignment="Center" MinWidth="52" />

                <TextBlock Grid.Column="3" x:Name="ResidualText" Classes="label" VerticalAlignment="Center" />

                <Button Grid.Column="4" Content="Start again" Click="OnReset" />
                <Button Grid.Column="5" Content="Cancel" Click="OnCancel" />
                <Button Grid.Column="6" x:Name="ApplyButton" Content="Apply" Classes="primary" Click="OnApply" IsEnabled="False" />
            </Grid>
        </Border>
    </Grid>
</Window>
