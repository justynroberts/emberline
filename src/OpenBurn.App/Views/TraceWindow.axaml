<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:OpenBurn.App.ViewModels"
        x:Class="OpenBurn.App.Views.TraceWindow"
        x:DataType="vm:TraceViewModel"
        Title="Trace image"
        Width="1000" Height="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgSunken}">

    <Grid ColumnDefinitions="*,304" Margin="14" ColumnSpacing="12">

        <!-- Preview. The traced paths over a ghost of the source, because the only
             way to judge a threshold is to see what it actually produces. -->
        <Border Grid.Column="0" Classes="panel focusIn">
            <DockPanel LastChildFill="True">
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Classes="sectionTitle" Text="PREVIEW" />
                    <TextBlock Grid.Column="1" Classes="mono" FontSize="10"
                               Foreground="{DynamicResource InkMuted}"
                               Text="{Binding SourceSummary}" VerticalAlignment="Center" />
                </Grid>

                <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,10,0,0">
                    <TextBlock Text="{Binding Summary}" Classes="mono" FontSize="11"
                               Foreground="{DynamicResource Cyan}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Note}" Classes="label" TextWrapping="Wrap"
                               IsVisible="{Binding HasNote}"
                               Foreground="{DynamicResource Ember}" />
                </StackPanel>

                <Border Background="{DynamicResource BgRaised}" CornerRadius="10" Padding="10" Margin="0,8,0,0">
                    <Image Source="{Binding Preview}" Stretch="Uniform" StretchDirection="Both" />
                </Border>
            </DockPanel>
        </Border>

        <!-- Controls -->
        <Border Grid.Column="1" Classes="panel focusInDelay1">
            <DockPanel LastChildFill="True">

                <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,12,0,0">
                    <TextBlock Classes="label" TextWrapping="Wrap"
                               Text="The trace is added as a new shape. The image stays where it is, so you can trace it again with different settings." />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <Button Grid.Column="0" Content="Reset" Command="{Binding ResetCommand}" />
                        <Button Grid.Column="1" Content="Cancel" HorizontalAlignment="Right" Click="OnCancel" />
                        <Button Grid.Column="2" Content="Add to design" Classes="primary" Click="OnApply" />
                    </Grid>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16">

                        <StackPanel Spacing="8">
                            <TextBlock Classes="sectionTitle" Text="WHAT TO FOLLOW" />

                            <CheckBox IsChecked="{Binding Centreline}" Content="Trace centrelines" />
                            <TextBlock Classes="label" TextWrapping="Wrap"
                                       Text="Off: follow the edge of every dark region, giving closed outlines. Best for silhouettes and cut lines. On: run a single line down the middle of each stroke. Best for line art, signatures and hand lettering, where following the edges would burn every line twice." />
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Classes="sectionTitle" Text="WHAT COUNTS AS INK" />

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBlock Grid.Column="0" Text="Threshold" Classes="label" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Threshold}" Classes="readout" FontSize="13" />
                            </Grid>
                            <Slider Minimum="1" Maximum="255" Value="{Binding Threshold}" />
                            <Button Content="Auto" Command="{Binding AutoThresholdCommand}" HorizontalAlignment="Left" />
                            <TextBlock Classes="label" TextWrapping="Wrap"
                                       Text="Anything darker than this is treated as ink. Auto picks the split that best separates the image's own light and dark, which beats a fixed value on anything scanned or photographed." />

                            <CheckBox IsChecked="{Binding Invert}" Content="Trace the light parts instead" />
                            <CheckBox IsChecked="{Binding Despeckle}" Content="Drop isolated pixels" />
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Classes="sectionTitle" Text="HOW CLEAN" />

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBlock Grid.Column="0" Text="Simplify" Classes="label" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Simplify, StringFormat={}{0:0.0} px}" Classes="readout" FontSize="13" />
                            </Grid>
                            <Slider Minimum="0" Maximum="4" Value="{Binding Simplify}" TickFrequency="0.1" IsSnapToTickEnabled="True" />

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBlock Grid.Column="0" Text="Smooth" Classes="label" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding SmoothPasses}" Classes="readout" FontSize="13" />
                            </Grid>
                            <Slider Minimum="0" Maximum="4" Value="{Binding SmoothPasses}" TickFrequency="1" IsSnapToTickEnabled="True" />

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBlock Grid.Column="0" Text="Ignore smaller than" Classes="label" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding MinimumArea, StringFormat={}{0} px}" Classes="readout" FontSize="13" />
                            </Grid>
                            <Slider Minimum="0" Maximum="400" Value="{Binding MinimumArea}" TickFrequency="1" IsSnapToTickEnabled="True" />

                            <TextBlock Classes="label" TextWrapping="Wrap"
                                       Text="Simplify drops points that sit on a straight run; smooth takes the stair-steps off. Both trade fidelity for a shorter, faster job — push them until the preview starts losing detail you care about." />
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Classes="sectionTitle" Text="PREVIEW" />
                            <CheckBox IsChecked="{Binding ShowSource}" Content="Show the image behind the paths" />
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
