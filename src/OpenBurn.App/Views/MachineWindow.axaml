<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:OpenBurn.App.ViewModels"
        xmlns:mach="clr-namespace:OpenBurn.Core.Machines;assembly=OpenBurn.Core"
        x:Class="OpenBurn.App.Views.MachineWindow"
        x:DataType="vm:MachineEditorViewModel"
        Title="Machines"
        Width="860" Height="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgSunken}">

    <Grid ColumnDefinitions="260,*" Margin="14" ColumnSpacing="12">

        <Border Grid.Column="0" Classes="panel focusIn">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top" Classes="sectionTitle" Text="MACHINES" />

                <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,10,0,0">
                    <Button Content="Add machine" HorizontalAlignment="Stretch" Command="{Binding AddNewCommand}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                        <Button Grid.Column="0" Content="Duplicate" Command="{Binding DuplicateCommand}" />
                        <Button Grid.Column="1" Content="Delete" Classes="danger" Command="{Binding DeleteCommand}" />
                    </Grid>
                </StackPanel>

                <ListBox ItemsSource="{Binding Machines}" SelectedItem="{Binding Selected}"
                         Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="mach:MachineProfile">
                            <StackPanel Margin="0,3">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="Medium" />
                                <TextBlock Text="{Binding Description}" Classes="mono" FontSize="10"
                                           Foreground="{DynamicResource InkMuted}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Classes="panel focusInDelay1">
            <DockPanel LastChildFill="True">

                <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,12,0,0">
                    <TextBlock Text="{Binding EditNote}" Classes="label" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Status}" Classes="mono" FontSize="10" TextWrapping="Wrap"
                               Foreground="{DynamicResource Cyan}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Content="Close" Click="OnClose" />
                        <Button Content="Save" Classes="primary" Command="{Binding SaveCommand}" />
                    </StackPanel>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14">

                        <StackPanel Spacing="8">
                            <TextBlock Classes="sectionTitle" Text="IDENTITY" />
                            <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="7">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" Classes="label" VerticalAlignment="Center" />
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding DisplayName}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Manufacturer" Classes="label" VerticalAlignment="Center" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Manufacturer}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Model" Classes="label" VerticalAlignment="Center" />
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Model}" />
                            </Grid>
                        </StackPanel>

                        <Separator />

                        <StackPanel Spacing="8">
                            <TextBlock Classes="sectionTitle" Text="BED AND LASER" />
                            <Grid ColumnDefinitions="120,*,120,*" RowDefinitions="Auto,Auto,Auto"
                                  ColumnSpacing="10" RowSpacing="7">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Bed width" Classes="label" VerticalAlignment="Center" />
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding BedWidthMm}" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Bed height" Classes="label" VerticalAlignment="Center" />
                                <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding BedHeightMm}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Laser watts" Classes="label" VerticalAlignment="Center" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding LaserWatts}"
                                         ToolTip.Tip="Optical output, not input power. This drives the material library." />
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="Origin" Classes="label" VerticalAlignment="Center" />
                                <ComboBox Grid.Row="1" Grid.Column="3" ItemsSource="{Binding Origins}"
                                          SelectedItem="{Binding Origin}" HorizontalAlignment="Stretch" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Max S value" Classes="label" VerticalAlignment="Center" />
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding MaxSpindleValue}"
                                         ToolTip.Tip="Must match the controller's $30, or every burn is at the wrong power." />
                            </Grid>
                        </StackPanel>

                        <Separator />

                        <StackPanel Spacing="8">
                            <TextBlock Classes="sectionTitle" Text="MOTION" />
                            <Grid ColumnDefinitions="120,*,120,*" RowDefinitions="Auto,Auto,Auto"
                                  ColumnSpacing="10" RowSpacing="7">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Max speed" Classes="label" VerticalAlignment="Center" />
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding MaxSpeedMmMin}" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Travel speed" Classes="label" VerticalAlignment="Center" />
                                <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding TravelSpeedMmMin}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Accel X" Classes="label" VerticalAlignment="Center" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding AccelerationX}" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="Accel Y" Classes="label" VerticalAlignment="Center" />
                                <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding AccelerationY}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Junction dev." Classes="label" VerticalAlignment="Center" />
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding JunctionDeviation}" />
                            </Grid>
                            <TextBlock Classes="label" TextWrapping="Wrap"
                                       Text="These only affect time estimates and the simulation. Read them from the machine with $$ and copy the values across." />
                        </StackPanel>

                        <Separator />

                        <StackPanel Spacing="8">
                            <TextBlock Classes="sectionTitle" Text="CONNECTION" />
                            <Grid ColumnDefinitions="120,*,120,*" RowDefinitions="Auto,Auto"
                                  ColumnSpacing="10" RowSpacing="7">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Baud" Classes="label" VerticalAlignment="Center" />
                                <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding BaudRates}"
                                          SelectedItem="{Binding BaudRate}" HorizontalAlignment="Stretch" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Host" Classes="label" VerticalAlignment="Center" />
                                <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding Host}" PlaceholderText="192.168.1.42" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="TCP port" Classes="label" VerticalAlignment="Center" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding TcpPort}" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="WebSocket" Classes="label" VerticalAlignment="Center" />
                                <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding WebSocketPort}" />
                            </Grid>
                        </StackPanel>

                        <Separator />

                        <StackPanel Spacing="6">
                            <TextBlock Classes="sectionTitle" Text="CAPABILITIES" />
                            <ItemsControl ItemsSource="{Binding Capabilities}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CapabilityToggle">
                                        <Grid ColumnDefinitions="150,*" Margin="0,2">
                                            <CheckBox Grid.Column="0" Content="{Binding Name}" IsChecked="{Binding IsSet}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Description}" Classes="label"
                                                       TextWrapping="Wrap" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
