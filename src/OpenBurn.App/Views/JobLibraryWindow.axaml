<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:jobs="clr-namespace:OpenBurn.Core.Jobs;assembly=OpenBurn.Core"
        x:Class="OpenBurn.App.Views.JobLibraryWindow"
        Title="Job library"
        Width="820" Height="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgSunken}">

    <Grid RowDefinitions="Auto,*,Auto" Margin="14">

        <Border Grid.Row="0" Classes="panel focusIn" Margin="0,0,0,12">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Job library" FontSize="{DynamicResource FontMedium}" FontWeight="SemiBold" />
                    <TextBlock x:Name="SummaryText" Classes="label" TextWrapping="Wrap" />
                </StackPanel>
                <TextBox Grid.Column="1" x:Name="SearchBox" PlaceholderText="Search by name, material or machine"
                         MinWidth="260" VerticalAlignment="Center" />
                <Button Grid.Column="2" Content="Refresh" x:Name="RefreshButton" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Classes="panel" Padding="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="JobList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="jobs:JobRecord">
                            <Border Classes="card" Margin="6,4">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border Grid.Column="0" Classes="chip" VerticalAlignment="Center"
                                            Background="{DynamicResource CyanSoft}">
                                        <TextBlock Text="{Binding Outcome}" FontSize="10" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                                        <TextBlock Text="{Binding Summary}" Classes="mono" FontSize="10"
                                                   Foreground="{DynamicResource InkMuted}" TextWrapping="Wrap" />
                                        <TextBlock Classes="label">
                                            <Run Text="{Binding StartedAt, StringFormat='{}{0:d MMM yyyy HH:mm}'}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding MachineName}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding LinesCompleted, StringFormat='{}{0:N0} lines'}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding FailureReason}" FontSize="11"
                                                   Foreground="{DynamicResource StateAlarm}"
                                                   IsVisible="{Binding FailureReason, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Classes="readout" VerticalAlignment="Center"
                                               Text="{Binding Duration, StringFormat='{}{0:mm\:ss}'}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2" Classes="panel focusInDelay1" Margin="0,12,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap" Classes="label"
                           Text="Everything is stored locally in openburn.db. Settings that finished successfully are the ones worth reusing — they are what actually worked on this machine." />
                <Button Grid.Column="1" Content="Close" x:Name="CloseButton" />
            </Grid>
        </Border>
    </Grid>
</Window>
