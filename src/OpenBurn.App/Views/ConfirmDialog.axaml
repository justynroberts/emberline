<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OpenBurn.App.Views.ConfirmDialog"
        Width="560" MaxHeight="560"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBase}">

    <Border Classes="panel focusIn" Margin="14">
        <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Top" Spacing="6">
                <TextBlock x:Name="TitleText" FontSize="{DynamicResource FontMedium}" FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="{DynamicResource InkMuted}" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                        Spacing="8" Margin="0,14,0,0">
                <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" />
                <Button x:Name="ConfirmButton" Classes="danger" Content="Confirm" />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0" MaxHeight="320">
                <Border Classes="card">
                    <TextBlock x:Name="DetailText" Classes="mono" FontSize="11" TextWrapping="Wrap" />
                </Border>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
