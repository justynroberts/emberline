<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OpenBurn.App"
             x:Class="OpenBurn.App.App"
             Name="OpenBurn"
             RequestedThemeVariant="Default">

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://OpenBurn/Styles/Tokens.axaml" />
        <StyleInclude Source="avares://OpenBurn/Styles/Controls.axaml" />
        <StyleInclude Source="avares://OpenBurn/Styles/Motion.axaml" />
    </Application.Styles>

    <Application.Resources>
        <FontFamily x:Key="DisplayFont">avares://OpenBurn/Assets/Fonts#Bricolage Grotesque</FontFamily>
        <FontFamily x:Key="MonoFont">avares://OpenBurn/Assets/Fonts#Spline Sans Mono</FontFamily>
    </Application.Resources>
</Application>
