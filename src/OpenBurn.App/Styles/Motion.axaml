<!-- Motion.

     Signature gesture: FOCUS-IN. Panels and cards arrive from blurred-and-small to
     sharp, 260 ms on a cubic-bezier(.22,1,.36,1) curve. It reads as a lens pulling
     focus, which is the right metaphor for an optical instrument.

     Motion here is transitional, never ambient. Nothing loops on a control the
     operator uses: a forever-pulsing button reads as a rendering fault, not as
     information. Machine state is carried by colour, icon and text. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector=":is(Control).focusIn">
        <Style.Animations>
            <Animation Duration="0:0:0.26" Easing="CubicEaseOut" FillMode="Forward">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="ScaleTransform.ScaleX" Value="0.97" />
                    <Setter Property="ScaleTransform.ScaleY" Value="0.97" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="ScaleTransform.ScaleX" Value="1" />
                    <Setter Property="ScaleTransform.ScaleY" Value="1" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Staggered entry, 45 ms apart, for panels that arrive together. -->
    <Style Selector=":is(Control).focusInDelay1">
        <Style.Animations>
            <Animation Duration="0:0:0.30" Delay="0:0:0.045" Easing="CubicEaseOut" FillMode="Forward">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="TranslateTransform.Y" Value="6" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="TranslateTransform.Y" Value="0" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <Style Selector=":is(Control).focusInDelay2">
        <Style.Animations>
            <Animation Duration="0:0:0.30" Delay="0:0:0.09" Easing="CubicEaseOut" FillMode="Forward">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="TranslateTransform.Y" Value="6" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="TranslateTransform.Y" Value="0" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <Style Selector=":is(Control).slideUp">
        <Style.Animations>
            <Animation Duration="0:0:0.22" Easing="CubicEaseOut" FillMode="Forward">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="TranslateTransform.Y" Value="18" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="TranslateTransform.Y" Value="0" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
</Styles>
