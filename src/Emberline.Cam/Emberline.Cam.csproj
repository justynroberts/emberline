<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="4.151.1" />

    <!-- Skia's native library is not in the managed package. Without this, every
         path that touches text or image decoding throws DllNotFoundException on
         Linux — the application does not start and neither do the tests. macOS and
         Windows carry their natives in the main package, which is why this only
         shows up on one of the three. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.151.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Emberline.Core\Emberline.Core.csproj" />
    <ProjectReference Include="..\Emberline.GCode\Emberline.GCode.csproj" />
  </ItemGroup>

</Project>
