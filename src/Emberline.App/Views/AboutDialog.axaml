<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Emberline.App.Views.AboutDialog"
        Title="About Emberline"
        Width="440" Height="430"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="BorderOnly"
        Background="{DynamicResource BgBase}">

    <Border Classes="panel" Margin="14" Classes.focusIn="True">
        <DockPanel LastChildFill="True">

            <StackPanel DockPanel.Dock="Top" Spacing="4">
                <TextBlock Text="Emberline"
                           FontSize="{DynamicResource FontDisplay}"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Ember}" />
                <TextBlock Text="Open-source laser cutting and engraving"
                           Foreground="{DynamicResource InkMuted}" />
                <TextBlock x:Name="VersionText" Classes="mono"
                           Foreground="{DynamicResource InkFaint}"
                           Margin="0,6,0,0" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                        HorizontalAlignment="Right" Spacing="8" Margin="0,14,0,0">
                <Button ToolTip.Tip="Close this panel." x:Name="CloseButton" Content="Close" Classes="primary" IsDefault="True" IsCancel="True" />
            </StackPanel>

            <StackPanel Spacing="12" Margin="0,18,0,0">
                <Separator />

                <StackPanel Spacing="3">
                    <TextBlock Classes="sectionTitle" Text="MACHINE" />
                    <TextBlock x:Name="MachineText" Classes="mono" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Spacing="3" x:Name="PluginSection">
                    <TextBlock Classes="sectionTitle" Text="PLUGINS" />
                    <TextBlock x:Name="PluginText" Classes="mono" TextWrapping="Wrap" FontSize="11" />
                </StackPanel>

                <StackPanel Spacing="3">
                    <TextBlock Classes="sectionTitle" Text="LICENCE" />
                    <TextBlock Text="GPLv3. Emberline incorporates algorithms derived from LaserGRBL, which is GPL-licensed."
                               TextWrapping="Wrap" Foreground="{DynamicResource InkMuted}" FontSize="{DynamicResource FontSmall}" />
                </StackPanel>

                <StackPanel Spacing="3">
                    <TextBlock Classes="sectionTitle" Text="SAFETY" />
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource InkMuted}" FontSize="{DynamicResource FontSmall}"
                               Text="Camera monitoring and software controls are aids, never substitutes for physical laser safety: interlocks, eye protection, extraction, a fire extinguisher, and never leaving a running machine unattended." />
                </StackPanel>

                <Separator />

                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Made by" Foreground="{DynamicResource InkMuted}" />
                    <HyperlinkButton x:Name="FintonLink"
                                     Content="FintonLabs"
                                     NavigateUri="https://fintonlabs.com"
                                     Foreground="{DynamicResource Ember}"
                                     Padding="0" />
                </StackPanel>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
