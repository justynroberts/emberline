<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Emberline.App.ViewModels"
        xmlns:raster="clr-namespace:Emberline.Cam.Raster;assembly=Emberline.Cam"
        xmlns:ctrl="clr-namespace:Emberline.App.Controls"
        xmlns:conv="clr-namespace:Emberline.App.Converters"
        xmlns:mach="clr-namespace:Emberline.Core.Machines;assembly=Emberline.Core"
        xmlns:tr="clr-namespace:Emberline.Transport;assembly=Emberline.Transport"
        xmlns:disc="clr-namespace:Emberline.Transport.Discovery;assembly=Emberline.Transport"
        xmlns:mat="clr-namespace:Emberline.Materials;assembly=Emberline.Materials"
        xmlns:cam="clr-namespace:Emberline.Camera;assembly=Emberline.Camera"
        xmlns:mach2="clr-namespace:Emberline.Core.Machines;assembly=Emberline.Core"
        x:Class="Emberline.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Emberline"
        Width="1480" Height="940"
        MinWidth="1080" MinHeight="700"
        Icon="avares://Emberline/Assets/emberline.png"
        Background="{DynamicResource BgSunken}">

    <Window.Resources>
        <conv:ThemeBrushConverter x:Key="ThemeBrush" />
        <conv:EnumEqualsConverter x:Key="EnumEquals" />
    </Window.Resources>

    <!-- Three rows: the toolbar and the status bar reserve their own height, and
         everything else lives between them. The chrome used to be a stack of
         floating panels positioned by hand-tuned margins, which meant the right
         inspector sat on top of the toolbar's far end the moment the toolbar
         grew — and every future change to either would have needed the numbers
         re-guessed. The canvas still spans all three rows and shows through. -->
    <Grid RowDefinitions="Auto,*,Auto">
        <!-- ============ The workspace fills the window; all chrome floats over it ============ -->
        <ctrl:WorkspaceView x:Name="Workspace" Grid.Row="0" Grid.RowSpan="3"
                            Machine="{Binding SelectedMachine}"
                            Design="{Binding Design}"
                            Toolpath="{Binding Toolpath}"
                            HeadPosition="{Binding DisplayHeadPosition}"
                            DocumentVersion="{Binding DocumentVersion}"
                            ProgressSegment="{Binding ProgressSegment}"
                            ShowGrid="{Binding ShowGrid}"
                            ShowTravel="{Binding ShowTravel}"
                            Selection="{Binding Selection}"
                            SnapEnabled="{Binding SnapEnabled}"
                            SnapMm="{Binding SnapMm}"
                            BedImage="{Binding BedImage}"
                            BedImageOpacity="{Binding BedImageOpacity}" />

        <!-- ================================ Top toolbar ================================ -->
        <!-- Grouped by what you are doing rather than one long column. The rail this
             replaces held twenty-odd buttons in a 60 px strip that scrolled on a short
             window, which meant the tools at the bottom were both unlabelled and
             hidden. Groups are separated by a rule and named underneath, so the
             icons are learnable rather than guessable. -->
        <Border Grid.Row="0" Classes="panel focusIn" Margin="12,12,12,0" Padding="12,8">
            <!-- Tools wrap; the job actions never do.
                 Fixed columns across the whole width overflowed a narrow window and
                 the emergency stop ended up underneath the group beside it. So the
                 tool groups now wrap onto a second line when there is not room, and
                 the job actions are pinned to the right where they cannot be pushed
                 off, covered, or scrolled away. The stop must be in the same place
                 every time it is reached for. -->
            <Grid ColumnDefinitions="*,Auto">

                <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">

                    <StackPanel Spacing="2" Margin="0,2,10,2">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button Classes="label" Command="{Binding NewDocumentCommand}"
                                    ToolTip.Tip="Start a new, empty design.">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Data="{StaticResource IconNew}" Width="16" Height="16" />
                                    <TextBlock Text="New" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Classes="label primary" Command="{Binding OpenCommand}"
                                    ToolTip.Tip="Open a file from this computer — SVG, DXF, a photograph, or G-code. Cmd/Ctrl+O does the same, and you can drag a file straight onto the window.">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Data="{StaticResource IconOpen}" Width="16" Height="16" />
                                    <TextBlock Text="Open" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Classes="label" Click="OnFindArtwork"
                                    ToolTip.Tip="Search open artwork catalogues — around 200,000 shapes across 150 free icon sets — and bring one onto the bed, to etch or to cut out. The licence is shown against every result.">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Data="{StaticResource IconArtwork}" Width="16" Height="16" />
                                    <TextBlock Text="Artwork" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Classes="label" Command="{Binding SaveDesignCommand}"
                                    ToolTip.Tip="Save the design — layers, artwork, workpiece and image settings — so it can be reopened and changed later. Cmd/Ctrl+S. This is the document; Export writes the G-code the machine runs.">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Data="{StaticResource IconSave}" Width="16" Height="16" />
                                    <TextBlock Text="Save" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Classes="label" Command="{Binding ExportGcodeCommand}"
                                    ToolTip.Tip="Write the G-code for this job as a .nc file, to run from an SD card or another sender. That is the output — it cannot be reopened and edited, so save the design as well.">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Data="{StaticResource IconGcode}" Width="16" Height="16" />
                                    <TextBlock Text="Export" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Text="FILE &amp; ARTWORK" Classes="sectionTitle" Margin="0" HorizontalAlignment="Center" />
                    </StackPanel>

                    <Border Width="1" Background="{DynamicResource Hairline}" Margin="0,4,10,4" />

                    <StackPanel Spacing="2" Margin="0,2,10,2">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button Classes="tool" ToolTip.Tip="Add a rectangle." Command="{Binding AddRectangleCommand}" >
                                <PathIcon Data="{StaticResource IconRectangle}" Width="18" Height="18" />
                            </Button>
                            <Button Classes="tool" ToolTip.Tip="Add a circle." Command="{Binding AddCircleCommand}" >
                                <PathIcon Data="{StaticResource IconCircle}" Width="18" Height="18" />
                            </Button>
                            <Button Classes="tool" ToolTip.Tip="Add a polygon." Command="{Binding AddPolygonCommand}" >
                                <PathIcon Data="{StaticResource IconPolygon}" Width="18" Height="18" />
                            </Button>
                            <Button Classes="tool" ToolTip.Tip="Add text, converted to cuttable outlines." Command="{Binding AddTextCommand}" >
                                <PathIcon Data="{StaticResource IconText}" Width="18" Height="18" />
                            </Button>
                            <Button Classes="tool" Click="OnTraceImage"
                                    ToolTip.Tip="Trace an image to vectors — the selected one, or pick a file." >
                                <PathIcon Data="{StaticResource IconTrace}" Width="18" Height="18" />
                            </Button>
                        </StackPanel>
                        <TextBlock Text="DRAW" Classes="sectionTitle" Margin="0" HorizontalAlignment="Center" />
                    </StackPanel>

                    <Border Width="1" Background="{DynamicResource Hairline}" Margin="0,4,10,4" />

                    <StackPanel Spacing="2" Margin="0,2,10,2">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button Classes="tool" ToolTip.Tip="Undo the last change." Command="{Binding UndoEditCommand}" >
                                <PathIcon Data="{StaticResource IconUndo}" Width="18" Height="18" />
                            </Button>
                            <Button Classes="tool" ToolTip.Tip="Redo the change you just undid." Command="{Binding RedoEditCommand}" >
                                <PathIcon Data="{StaticResource IconRedo}" Width="18" Height="18" />
                            </Button>
                            <Button Classes="tool" ToolTip.Tip="Duplicate the selection." Command="{Binding DuplicateSelectedCommand}" >
                                <PathIcon Data="{StaticResource IconDuplicate}" Width="18" Height="18" />
                            </Button>
                            <Button Classes="tool" ToolTip.Tip="Delete the selection." Command="{Binding DeleteSelectedCommand}" >
                                <PathIcon Data="{StaticResource IconDelete}" Width="18" Height="18" />
                            </Button>
                        </StackPanel>
                        <TextBlock Text="EDIT" Classes="sectionTitle" Margin="0" HorizontalAlignment="Center" />
                    </StackPanel>

                    <Border Width="1" Background="{DynamicResource Hairline}" Margin="0,4,10,4" />

                    <StackPanel Spacing="2" Margin="0,2,10,2">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button Classes="tool" ToolTip.Tip="Zoom so the whole bed is in view." Click="OnZoomBed" >
                                <PathIcon Data="{StaticResource IconFitBed}" Width="18" Height="18" />
                            </Button>
                            <Button Classes="tool" ToolTip.Tip="Zoom so the artwork fills the view." Click="OnZoomContent" >
                                <PathIcon Data="{StaticResource IconFitContent}" Width="18" Height="18" />
                            </Button>
                            <Button Classes="tool" ToolTip.Tip="Show or hide the grid." Command="{Binding ToggleGridCommand}" >
                                <PathIcon Data="{StaticResource IconGrid}" Width="18" Height="18" />
                            </Button>
                            <Button Classes="tool" ToolTip.Tip="Show the rapid moves between cuts, so you can see the order and the wasted travel." Command="{Binding ToggleTravelCommand}" >
                                <PathIcon Data="{StaticResource IconTravel}" Width="18" Height="18" />
                            </Button>
                        </StackPanel>
                        <TextBlock Text="VIEW" Classes="sectionTitle" Margin="0" HorizontalAlignment="Center" />
                    </StackPanel>

                    <Border Width="1" Background="{DynamicResource Hairline}" Margin="0,4,10,4" />

                    <StackPanel Spacing="2" Margin="0,2,10,2">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button Classes="tool" ToolTip.Tip="Play the job on screen. This draws the toolpath and moves nothing." Command="{Binding PlaySimulationCommand}" >
                                <PathIcon Data="{StaticResource IconPlay}" Width="18" Height="18" />
                            </Button>
                            <Button Classes="tool" ToolTip.Tip="Inspect the exact G-code that will be sent." Command="{Binding ToggleGcodeCommand}" >
                                <PathIcon Data="{StaticResource IconGcode}" Width="18" Height="18" />
                            </Button>
                            <Button Classes="tool" ToolTip.Tip="Open the machine console to see and send raw commands." Command="{Binding ToggleConsoleCommand}" >
                                <PathIcon Data="{StaticResource IconConsole}" Width="18" Height="18" />
                            </Button>
                            <Button Classes="tool" ToolTip.Tip="Past jobs and the settings they ran with." Click="OnShowJobLibrary" >
                                <PathIcon Data="{StaticResource IconHistory}" Width="18" Height="18" />
                            </Button>
                            <Button Classes="tool" ToolTip.Tip="The controller's $ settings, each one named and explained." Click="OnShowSettings" >
                                <PathIcon Data="{StaticResource IconSettings}" Width="18" Height="18" />
                            </Button>
                        </StackPanel>
                        <TextBlock Text="INSPECT" Classes="sectionTitle" Margin="0" HorizontalAlignment="Center" />
                    </StackPanel>

                    <Border Width="1" Background="{DynamicResource Hairline}" Margin="0,4,10,4" />

                    <StackPanel Spacing="2" Margin="0,2,10,2">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button Classes="tool" Click="OnShowWizard"
                                    ToolTip.Tip="Walk me through it — machine, material, artwork, settings, then a check before you run anything." >
                                <PathIcon Data="{StaticResource IconWizard}" Width="18" Height="18" />
                            </Button>
                            <Button Classes="tool" ToolTip.Tip="Switch between the light and dark themes." Command="{Binding CycleThemeCommand}" >
                                <PathIcon Data="{StaticResource IconTheme}" Width="18" Height="18" />
                            </Button>
                            <Button Classes="tool" AutomationProperties.Name="About this app"
                                    ToolTip.Tip="About Emberline." Click="OnShowAbout" >
                                <PathIcon Data="{StaticResource IconAbout}" Width="18" Height="18" />
                            </Button>
                        </StackPanel>
                        <TextBlock Text="HELP" Classes="sectionTitle" Margin="0" HorizontalAlignment="Center" />
                    </StackPanel>
                </WrapPanel>

                <!-- Pinned right, always on one line, never wrapped.

                     The job buttons and the emergency stop share row 0, so their
                     centres line up because they are in the same row rather than
                     because a margin was guessed to make it look that way. The
                     group label sits in row 1 under the job buttons only — putting
                     it under the whole thing was what pushed the stop's centre
                     lower than theirs. -->
                <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto,Auto" RowDefinitions="Auto,Auto"
                      Margin="10,0,0,0">

                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="6"
                                VerticalAlignment="Center">
                        <Button Classes="job" Content="Frame" Command="{Binding FrameCommand}"
                                ToolTip.Tip="Trace the job outline at pointer power so you can check where it will land before burning anything." />
                        <Button Classes="job primary" Content="Start" Command="{Binding StartJobCommand}"
                                IsVisible="{Binding !IsJobActive}" ToolTip.Tip="{Binding StartHint}" />
                        <Button Classes="job" Content="Pause" Command="{Binding PauseJobCommand}" IsVisible="{Binding IsJobRunning}"
                                ToolTip.Tip="Pause after the current move. The laser switches off and the head stays where it is, so you can resume in the same place." />
                        <Button Classes="job primary" Content="Resume" Command="{Binding ResumeJobCommand}" IsVisible="{Binding IsJobPaused}"
                                ToolTip.Tip="Carry on from exactly where the job paused." />
                        <Button Classes="job" Content="Stop" Command="{Binding StopJobCommand}" IsVisible="{Binding IsJobActive}"
                                ToolTip.Tip="End the job and switch the laser off. This cannot be resumed — use Pause if you only need a moment." />
                    </StackPanel>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="JOB" Classes="sectionTitle"
                               Margin="0" HorizontalAlignment="Center" />

                    <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Width="1"
                            Background="{DynamicResource Hairline}" Margin="10,4" />

                    <Button Grid.Row="0" Grid.Column="2" Classes="estop" VerticalAlignment="Center"
                            Command="{Binding EmergencyStopCommand}"
                            AutomationProperties.Name="Emergency stop"
                            ToolTip.Tip="Emergency stop — feed hold, beam off, controller reset. Escape does the same from anywhere in the window. This is not a substitute for the switch on the machine.">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <PathIcon Data="{StaticResource IconStop}" Width="22" Height="22"
                                      Foreground="#FFFFFF" VerticalAlignment="Center" />
                            <TextBlock Text="STOP" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- ============================ Job progress strip ============================ -->
        <Border Grid.Row="1" Classes="panel slideUp" Margin="12,12,352,0" Padding="14,10"
                VerticalAlignment="Top"
                IsVisible="{Binding IsJobActive}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                <StackPanel Grid.Column="0" Spacing="7" VerticalAlignment="Center">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding ProgressText}" Classes="mono" />
                        <TextBlock Grid.Column="1" Text="{Binding JobProgress.CurrentLine}" Classes="mono"
                                   Foreground="{DynamicResource InkFaint}" MaxWidth="260"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding JobProgress.Fraction, Mode=OneWay}" />
                </StackPanel>

                <!-- Live bed view while a job runs. An aid to watching the machine,
                     never a substitute for being in the room with it. -->
                <Border Grid.Column="1" Classes="card" Padding="3" IsVisible="{Binding ShowLiveView}">
                    <StackPanel Spacing="3">
                        <Image Source="{Binding LiveView}" Width="150" Height="96" Stretch="UniformToFill" />
                        <TextBlock Text="live bed" Classes="sectionTitle" Margin="0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ============================= Fault banner ================================= -->
        <Border Grid.Row="1" Classes="panel slideUp" Margin="12,0,352,12" Padding="14,11"
                VerticalAlignment="Bottom" IsVisible="{Binding HasFault}"
                BorderBrush="{DynamicResource StateAlarm}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <PathIcon Grid.Column="0" Data="{StaticResource IconAlert}" Width="20" Height="20" Margin="0,0,12,0"
                          Foreground="{DynamicResource StateAlarm}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding FaultText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button ToolTip.Tip="Clear the alarm so the machine accepts moves again. Find out why it alarmed before you do this; the position may no longer be trusted." Content="Unlock" Command="{Binding UnlockCommand}" />
                    <Button Content="Diagnose" Command="{Binding DiagnoseFaultCommand}"
                            ToolTip.Tip="Ask the assistant what this means, with the console log attached" />
                    <Button ToolTip.Tip="Hide this message. It does not fix the underlying problem." Content="Dismiss" Classes="ghost" Command="{Binding DismissFaultCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================= Right inspector ============================== -->
        <Border Grid.Row="1" Classes="panel focusInDelay2" Width="328" Margin="0,12,12,0"
                HorizontalAlignment="Right" VerticalAlignment="Stretch" Padding="0">
            <DockPanel LastChildFill="True">

                <!-- Context tabs. Four short panels rather than one column fourteen
                     sections deep, grouped by the question being asked: what is the
                     machine doing, what will be burned, what is selected, what is
                     about to run. -->
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,*,*,*" ColumnSpacing="4" Margin="14,14,14,0">
                    <Button Grid.Column="0" Classes="segment" Classes.selected="{Binding IsMachineTab}"
                            Content="Machine" Command="{Binding SelectInspectorTabCommand}" CommandParameter="Machine"
                            ToolTip.Tip="Connection, jogging, camera and rotary" />
                    <Button Grid.Column="1" Classes="segment" Classes.selected="{Binding IsDesignTab}"
                            Content="Design" Command="{Binding SelectInspectorTabCommand}" CommandParameter="Design"
                            ToolTip.Tip="Material, layers and what each one does" />
                    <Button Grid.Column="2" Classes="segment" Classes.selected="{Binding IsObjectTab}"
                            Content="Object" Command="{Binding SelectInspectorTabCommand}" CommandParameter="Object"
                            ToolTip.Tip="Size, position, alignment and text — for what is selected" />
                    <Button Grid.Column="3" Classes="segment" Classes.selected="{Binding IsJobTab}"
                            Content="Job" Command="{Binding SelectInspectorTabCommand}" CommandParameter="Job"
                            ToolTip.Tip="What the job comes to, and anything blocking it" />
                </Grid>

                <!-- The scrollbar is an overlay, so leave it room or it sits on top of
                     the right-hand value readouts. -->
                <ScrollViewer Margin="14,12,8,14" VerticalScrollBarVisibility="Auto">
                    <Panel Margin="0,0,8,0">
                    <StackPanel Spacing="14" IsVisible="{Binding IsMachineTab}">
                    <!-- Connection -->
                    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="14,14,14,0">
                        <TextBlock Classes="sectionTitle" Text="MACHINE" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <ComboBox ToolTip.Tip="Which machine you are sending to. This sets the bed size, laser wattage and speed limits used for every calculation." Grid.Column="0" ItemsSource="{Binding Machines.Profiles}"
                                  SelectedItem="{Binding SelectedMachine}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="mach:MachineProfile">
                                    <TextBlock Text="{Binding DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                            <Button Grid.Column="1"  Width="34" Padding="0"
                                    ToolTip.Tip="Add or edit machine profiles" Click="OnEditMachines" >
                                <PathIcon Data="{StaticResource IconMore}" Width="16" Height="16" />
                            </Button>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                            <ComboBox ToolTip.Tip="The USB port your machine is plugged into. If you are unsure, unplug it, press the refresh arrow, plug it back in and see which one appears." Grid.Column="0" ItemsSource="{Binding SerialPorts}"
                                      SelectedValue="{Binding SelectedPort}"
                                      SelectedValueBinding="{Binding PortName}"
                                      HorizontalAlignment="Stretch"
                                      PlaceholderText="Serial port">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="tr:SerialPortInfo">
                                        <TextBlock Text="{Binding PortName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="1"  Width="34" Padding="0"
                                    ToolTip.Tip="Rescan serial ports" Command="{Binding RefreshPortsCommand}" >
                                <PathIcon Data="{StaticResource IconRefresh}" Width="16" Height="16" />
                            </Button>
                        </Grid>

                        <TextBox Text="{Binding NetworkAddress}" PlaceholderText="192.168.1.42:23" />

                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                            <Button ToolTip.Tip="Connect over the USB cable using the port selected above." Grid.Column="0" Content="USB" Command="{Binding ConnectSerialCommand}" />
                            <Button ToolTip.Tip="Connect over the network to the address in the box above." Grid.Column="1" Content="Wi-Fi" Command="{Binding ConnectNetworkCommand}" />
                            <Button Grid.Column="2" Content="Virtual" Command="{Binding ConnectVirtualCommand}"
                                    ToolTip.Tip="Run against the built-in simulator — no hardware needed" />
                        </Grid>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                            <Button ToolTip.Tip="Look for machines on your local network. Nothing is sent to them beyond a request for their name." Grid.Column="0" Content="Scan network" Command="{Binding ScanNetworkCommand}" />
                            <Button ToolTip.Tip="Close the connection. The machine keeps its position and settings." Grid.Column="1" Content="Disconnect" Command="{Binding DisconnectCommand}" />
                        </Grid>

                        <ProgressBar Minimum="0" Maximum="1" Value="{Binding DiscoveryProgress}"
                                     IsVisible="{Binding IsBusy}" />
                        <TextBlock Text="{Binding BusyMessage}" Classes="label" IsVisible="{Binding IsBusy}" />

                        <ItemsControl ItemsSource="{Binding DiscoveredDevices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="disc:DiscoveredDevice">
                                    <Button ToolTip.Tip="Connect to this machine." Classes="ghost" HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ConnectDiscoveredCommand}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Text="{Binding Summary}" Classes="mono" FontSize="11" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                        <!-- Jog -->
                        <StackPanel Spacing="8">
                            <TextBlock Classes="sectionTitle" Text="JOG" />
                            <UniformGrid Rows="3" Columns="3" HorizontalAlignment="Center">
                                <Button ToolTip.Tip="Move the head up and to the left by one step." Classes="jog"  Command="{Binding JogCommand}" CommandParameter="upleft" >
                                <PathIcon Data="{StaticResource IconJogUpLeft}" Width="16" Height="16" />
                            </Button>
                                <Button ToolTip.Tip="Move the head away from you by one step." Classes="jog"  Command="{Binding JogCommand}" CommandParameter="up" >
                                <PathIcon Data="{StaticResource IconJogUp}" Width="16" Height="16" />
                            </Button>
                                <Button ToolTip.Tip="Move the head up and to the right by one step." Classes="jog"  Command="{Binding JogCommand}" CommandParameter="upright" >
                                <PathIcon Data="{StaticResource IconJogUpRight}" Width="16" Height="16" />
                            </Button>
                                <Button ToolTip.Tip="Move the head left by one step." Classes="jog"  Command="{Binding JogCommand}" CommandParameter="left" >
                                <PathIcon Data="{StaticResource IconJogLeft}" Width="16" Height="16" />
                            </Button>
                                <Button Classes="jog"  Command="{Binding HomeCommand}" ToolTip.Tip="Home ($H)" >
                                <PathIcon Data="{StaticResource IconHome}" Width="16" Height="16" />
                            </Button>
                                <Button ToolTip.Tip="Move the head right by one step." Classes="jog"  Command="{Binding JogCommand}" CommandParameter="right" >
                                <PathIcon Data="{StaticResource IconJogRight}" Width="16" Height="16" />
                            </Button>
                                <Button ToolTip.Tip="Move the head down and to the left by one step." Classes="jog"  Command="{Binding JogCommand}" CommandParameter="downleft" >
                                <PathIcon Data="{StaticResource IconJogDownLeft}" Width="16" Height="16" />
                            </Button>
                                <Button ToolTip.Tip="Move the head towards you by one step." Classes="jog"  Command="{Binding JogCommand}" CommandParameter="down" >
                                <PathIcon Data="{StaticResource IconJogDown}" Width="16" Height="16" />
                            </Button>
                                <Button ToolTip.Tip="Move the head down and to the right by one step." Classes="jog"  Command="{Binding JogCommand}" CommandParameter="downright" >
                                <PathIcon Data="{StaticResource IconJogDownRight}" Width="16" Height="16" />
                            </Button>
                            </UniformGrid>

                            <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="6">
                                <TextBlock Grid.Column="0" Text="Step" Classes="label" VerticalAlignment="Center" />
                                <ComboBox ToolTip.Tip="How far the head moves each time you press a jog arrow." Grid.Column="1" ItemsSource="{Binding JogSteps}"
                                          SelectedItem="{Binding JogStepMm}" HorizontalAlignment="Stretch" />
                                <TextBlock Grid.Column="2" Text="Feed" Classes="label" VerticalAlignment="Center" />
                                <ComboBox ToolTip.Tip="How fast the head moves while jogging. This does not affect the job." Grid.Column="3" ItemsSource="{Binding JogFeeds}"
                                          SelectedItem="{Binding JogFeedMmMin}" HorizontalAlignment="Stretch" />
                            </Grid>

                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                                <Button ToolTip.Tip="Set this spot as the origin — the corner your artwork is measured from. Jog to the corner of your material first." Grid.Column="0" Content="Zero XY" Command="{Binding ZeroAllCommand}" />
                                <Button ToolTip.Tip="Clear the alarm so the machine accepts moves again. Find out why it alarmed first." Grid.Column="1" Content="Unlock" Command="{Binding UnlockCommand}" />
                                <Button ToolTip.Tip="Send the head back to the origin you set with Zero XY. The laser stays off." Grid.Column="2" Content="Origin" Command="{Binding GoToOriginCommand}" />
                            </Grid>
                        </StackPanel>

                        <Separator />

                        <!-- Camera -->
                        <StackPanel Spacing="8">
                            <TextBlock Classes="sectionTitle" Text="CAMERA" />

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                <ComboBox ToolTip.Tip="Which camera to use for seeing the bed. Pick Synthetic bed camera to practise without any hardware." Grid.Column="0" ItemsSource="{Binding Cameras}"
                                          SelectedItem="{Binding SelectedCamera}"
                                          HorizontalAlignment="Stretch"
                                          PlaceholderText="No camera">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="cam:CameraDescriptor">
                                            <TextBlock Text="{Binding Name}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="1"  Width="34" Padding="0"
                                        ToolTip.Tip="Rescan cameras" Command="{Binding RefreshCamerasCommand}" >
                                <PathIcon Data="{StaticResource IconRefresh}" Width="16" Height="16" />
                            </Button>
                            </Grid>

                            <TextBox Text="{Binding CameraAddress}"
                                     PlaceholderText="http://192.168.1.50/stream" />

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                <Button ToolTip.Tip="Start receiving pictures from the camera." Grid.Column="0" Content="Connect" Command="{Binding ConnectCameraCommand}" />
                                <Button ToolTip.Tip="Take one picture of the bed and show it behind your artwork, so you can place work over the material you can actually see." Grid.Column="1" Content="Capture bed" Command="{Binding CaptureBedCommand}" />
                            </Grid>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                <Button ToolTip.Tip="Teach the camera where the bed is by clicking its four corners. Without this the picture cannot be lined up with real millimetres." Grid.Column="0" Content="Calibrate" Click="OnCalibrateCamera" />
                                <Button Grid.Column="1" Content="Find objects" Command="{Binding DetectWorkpiecesCommand}"
                                        ToolTip.Tip="Detect workpieces on the bed and move the selection onto the largest" />
                            </Grid>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                <Button Grid.Column="0" Content="Set marks" Command="{Binding SetFiducialReferenceCommand}"
                                        ToolTip.Tip="Remember where the registration marks are, with the artwork aligned to the workpiece" />
                                <Button Grid.Column="1" Content="Align to marks" Command="{Binding AlignToFiducialsCommand}"
                                        IsEnabled="{Binding HasFiducialReference}"
                                        ToolTip.Tip="Move the artwork to follow the marks after the workpiece has been replaced" />
                            </Grid>

                            <TextBlock Text="{Binding FiducialStatus}" TextWrapping="Wrap" Classes="label"
                                       IsVisible="{Binding FiducialStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                            <TextBlock Text="{Binding CalibrationSummary}" Classes="label" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding CameraStatus}" TextWrapping="Wrap"
                                       FontSize="{DynamicResource FontSmall}"
                                       Foreground="{DynamicResource InkMuted}"
                                       IsVisible="{Binding CameraStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <CheckBox ToolTip.Tip="Show the camera picture behind your artwork on the canvas." Grid.Column="0" Content="Show" IsChecked="{Binding ShowBedImage}" />
                                <Slider Grid.Column="1" Minimum="0.15" Maximum="1" Value="{Binding BedImageOpacity}"
                                        ToolTip.Tip="How strongly the camera view shows through" />
                                <Button ToolTip.Tip="Remove the camera picture from the canvas." Grid.Column="2" Content="Clear" Classes="ghost" Padding="8,2"
                                        Command="{Binding ClearBedImageCommand}" />
                            </Grid>
                        </StackPanel>

                        <Separator />

                        <!-- Rotary -->
                        <StackPanel Spacing="8" IsVisible="{Binding MachineHasRotary}">
                            <TextBlock Classes="sectionTitle" Text="ROTARY" />
                            <CheckBox ToolTip.Tip="Turn on rotary mode for engraving round objects such as tumblers. The Y axis then rotates the workpiece instead of moving the head." Content="Rotary mode" IsChecked="{Binding RotaryEnabled}" />

                            <StackPanel Spacing="8" IsVisible="{Binding RotaryEnabled}">
                                <ComboBox ToolTip.Tip="Which kind of rotary attachment you have. Rollers spin the object by friction; a chuck grips its end." ItemsSource="{Binding RotaryKinds}" SelectedItem="{Binding RotaryKind}"
                                          HorizontalAlignment="Stretch" />

                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto"
                                      ColumnSpacing="10" RowSpacing="6">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Workpiece diameter" Classes="label" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding RotaryWorkpieceDiameterMm}" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Roller diameter" Classes="label" VerticalAlignment="Center"
                                               IsVisible="{Binding !IsChuck}" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding RotaryRollerDiameterMm}"
                                             IsVisible="{Binding !IsChuck}" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Steps/turn" Classes="label" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding RotaryStepsPerRotation}" />
                                </Grid>

                                <TextBlock Text="{Binding AxisStepsSource}" Classes="label" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding RotarySummary}" Classes="mono" FontSize="10"
                                           TextWrapping="Wrap" Foreground="{DynamicResource InkMuted}" />
                                <TextBlock Text="{Binding RotaryWarningText}" TextWrapping="Wrap"
                                           FontSize="{DynamicResource FontSmall}"
                                           Foreground="{DynamicResource StateHold}"
                                           IsVisible="{Binding HasRotaryWarnings}" />

                                <Button Content="Test one rotation" HorizontalAlignment="Stretch"
                                        Command="{Binding TestRotationCommand}"
                                        ToolTip.Tip="Turn the workpiece a full turn so you can check it runs true" />
                            </StackPanel>
                        </StackPanel>

                        <Separator />

                    </StackPanel>

                    <StackPanel Spacing="14" IsVisible="{Binding IsDesignTab}">
                        <!-- Workpiece: the material actually on the bed, as
                             opposed to the bed itself. -->
                        <StackPanel Spacing="8">
                            <TextBlock Classes="sectionTitle" Text="WORKPIECE" />

                            <ComboBox ItemsSource="{Binding WorkpiecePresets}" SelectedItem="{Binding SelectedWorkpiecePreset}"
                                      HorizontalAlignment="Stretch" PlaceholderText="No workpiece"
                                      ToolTip.Tip="The piece of material you are burning onto. Its outline is drawn faintly on the canvas so you can line artwork up against the material rather than against the whole bed." />

                            <StackPanel Spacing="8" IsVisible="{Binding !HasWorkpiece}">
                                <Button Content="Set a size" HorizontalAlignment="Stretch"
                                        Command="{Binding UseCustomWorkpieceCommand}"
                                        ToolTip.Tip="Describe the blank by typing its size, for an offcut that does not match any of the presets." />
                            </StackPanel>

                            <StackPanel Spacing="8" IsVisible="{Binding HasWorkpiece}">
                                <CheckBox IsChecked="{Binding WorkpieceIsRound}" Content="Round"
                                          ToolTip.Tip="Draw the outline as a circle rather than a rectangle — for coasters, discs and round tags." />

                                <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="6" RowSpacing="6" RowDefinitions="Auto,Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="W" Classes="label" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding WorkpieceWidthMm, StringFormat={}{0:0.##}}"
                                             ToolTip.Tip="How wide the material is, in millimetres. For a round blank this is the diameter." />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="H" Classes="label" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding WorkpieceHeightMm, StringFormat={}{0:0.##}}"
                                             ToolTip.Tip="How tall the material is, in millimetres." />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="X" Classes="label" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding WorkpieceXMm, StringFormat={}{0:0.##}}"
                                             ToolTip.Tip="Where the left edge of the material sits on the bed." />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Y" Classes="label" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding WorkpieceYMm, StringFormat={}{0:0.##}}"
                                             ToolTip.Tip="Where the bottom edge of the material sits on the bed." />
                                </Grid>

                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" IsVisible="{Binding !WorkpieceIsRound}">
                                    <TextBlock Grid.Column="0" Text="Corner" Classes="label" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding WorkpieceCornerMm, StringFormat={}{0:0.##}}"
                                             ToolTip.Tip="Corner radius in millimetres, for blanks with rounded corners. Zero is square." />
                                </Grid>

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="6" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                                    <Button Grid.Row="0" Grid.Column="0" Content="Centre on bed"
                                            Command="{Binding CentreWorkpieceOnBedCommand}"
                                            ToolTip.Tip="Put the material in the middle of the bed." />
                                    <Button Grid.Row="0" Grid.Column="1" Content="Clear"
                                            Command="{Binding ClearWorkpieceCommand}"
                                            ToolTip.Tip="Forget the workpiece and go back to showing just the bed." />
                                    <Button Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Classes="primary"
                                            Content="Centre artwork on it"
                                            Command="{Binding CentreArtworkOnWorkpieceCommand}"
                                            ToolTip.Tip="Move the artwork to the middle of the material. Uses the selection if there is one, otherwise everything in the design." />
                                    <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Content="Save this size"
                                            Command="{Binding SaveWorkpieceCommand}"
                                            IsVisible="{Binding CanSaveWorkpiece}"
                                            ToolTip.Tip="Keep this blank in the list, so a shape you cut repeatedly does not have to be measured and typed in again next time." />
                                </Grid>
                            </StackPanel>
                        </StackPanel>

                        <Separator />

                        <!-- Material -->
                        <StackPanel Spacing="8">
                            <TextBlock Classes="sectionTitle" Text="MATERIAL" />
                            <ComboBox ToolTip.Tip="Pick a material to get a tested starting point for speed and power. It is a starting point, not an answer — always test on an offcut." ItemsSource="{Binding AvailableMaterials}"
                                      SelectedItem="{Binding SelectedMaterial}"
                                      HorizontalAlignment="Stretch"
                                      PlaceholderText="Choose a material">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="mat:MaterialProfile">
                                        <TextBlock Text="{Binding FullPath}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="{Binding MaterialNotes}" Classes="label" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding MaterialHazard}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource StateAlarm}" FontSize="{DynamicResource FontSmall}"
                                       IsVisible="{Binding HasMaterialHazard}" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                <Button ToolTip.Tip="Copy this material's speed and power onto your layers, rescaled for your machine's wattage." Grid.Column="0" Content="Apply" Command="{Binding ApplyMaterialCommand}" />
                                <Button Grid.Column="1" Content="Test grid" Command="{Binding RunTestGridCommand}"
                                        ToolTip.Tip="Burn a power × speed matrix on an offcut" />
                            </Grid>
                        </StackPanel>

                        <Separator />

                        <!-- Layers -->
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                                <TextBlock Grid.Column="0" Classes="sectionTitle" Text="LAYERS" VerticalAlignment="Center" />
                                <Button ToolTip.Tip="Move this layer earlier, so it burns before the ones below it." Grid.Column="1"  Classes="ghost" Padding="6,2" Command="{Binding MoveLayerUpCommand}" >
                                <PathIcon Data="{StaticResource IconJogUp}" Width="16" Height="16" />
                            </Button>
                                <Button ToolTip.Tip="Move this layer later, so it burns after the ones above it." Grid.Column="2"  Classes="ghost" Padding="6,2" Command="{Binding MoveLayerDownCommand}" >
                                <PathIcon Data="{StaticResource IconJogDown}" Width="16" Height="16" />
                            </Button>
                                <Button ToolTip.Tip="Add another layer. Layers let one design engrave some parts and cut others." Grid.Column="3"  Classes="ghost" Padding="6,2" Command="{Binding AddLayerCommand}" >
                                <PathIcon Data="{StaticResource IconPlus}" Width="16" Height="16" />
                            </Button>
                                <Button ToolTip.Tip="Delete the selected layer. Anything on it moves to the layer above." Grid.Column="4"  Classes="ghost" Padding="6,2" Command="{Binding RemoveLayerCommand}" >
                                <PathIcon Data="{StaticResource IconMinus}" Width="16" Height="16" />
                            </Button>
                            </Grid>

                            <ListBox ItemsSource="{Binding Layers}" SelectedItem="{Binding SelectedLayer}"
                                     Background="Transparent" BorderThickness="0" MaxHeight="190">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LayerViewModel">
                                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8" Margin="0,3">
                                            <CheckBox ToolTip.Tip="Include this layer in the job. Unticked layers are still shown on the canvas but are not burned." Grid.Column="0" IsChecked="{Binding Enabled}" />
                                            <Border Grid.Column="1" Width="4" CornerRadius="2"
                                                    Background="{Binding ColorHex, Converter={StaticResource ThemeBrush}}" />
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                                                <TextBlock Text="{Binding Summary}" Classes="mono"
                                                           FontSize="10" Foreground="{DynamicResource InkMuted}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>

                        <!-- Selected layer settings -->
                        <ContentControl Content="{Binding SelectedLayer}">
                          <ContentControl.ContentTemplate>
                            <DataTemplate x:DataType="vm:LayerViewModel">
                        <StackPanel Spacing="8">
                            <Separator />
                            <TextBlock Classes="sectionTitle" Text="OPERATION" />
                            <ComboBox ToolTip.Tip="What this layer does. Engrave marks the surface, Score draws a light line, Cut goes through, Fill darkens a whole area." ItemsSource="{x:Static vm:LayerViewModel.Operations}"
                                      SelectedItem="{Binding Operation}" HorizontalAlignment="Stretch" />

                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto"
                                  ColumnSpacing="10" RowSpacing="7">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Speed" Classes="label" VerticalAlignment="Center" />
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SpeedMmMin}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Power %" Classes="label" VerticalAlignment="Center" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PowerPercent}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Passes" Classes="label" VerticalAlignment="Center" />
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Passes}" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Interval" Classes="label" VerticalAlignment="Center" />
                                <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                    <TextBox Grid.Column="0" Text="{Binding LineIntervalMm}" />
                                    <TextBlock Grid.Column="1" Text="{Binding DpiText}" Classes="label" VerticalAlignment="Center" />
                                </Grid>
                            </Grid>

                            <CheckBox ToolTip.Tip="Switch the air assist on for this layer. Air blows smoke away from the cut, which gives a cleaner edge and less scorching." Content="Air assist" IsChecked="{Binding AirAssist}" />
                            <CheckBox Content="Merge overlapping shapes" IsChecked="{Binding MergeOverlaps}"
                                      ToolTip.Tip="Cut the combined outline of shapes that overlap, rather than each one separately — otherwise the beam runs through the middle of the finished piece. Holes are unaffected: a shape entirely inside another stays a hole. Turn this off when the crossing lines are the point, such as a scored grid." />

                            <StackPanel Spacing="7" IsVisible="{Binding IsFill}">
                                <TextBlock Classes="sectionTitle" Text="FILL" Margin="0,4,0,0" />
                                <ComboBox ToolTip.Tip="How a filled area is burned in: side to side like a printer, or as a pattern of lines." ItemsSource="{x:Static vm:LayerViewModel.FillStrategies}"
                                          SelectedItem="{Binding FillStrategy}" HorizontalAlignment="Stretch" />
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <TextBlock Grid.Column="0" Text="Angle" Classes="label" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding FillAngleDeg}" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                            </DataTemplate>
                          </ContentControl.ContentTemplate>
                        </ContentControl>

                        <Separator />

                    </StackPanel>

                    <StackPanel Spacing="14" IsVisible="{Binding IsObjectTab}">
                        <!-- Image adjustments. Only for a selected bitmap: none of it
                             means anything for vector geometry. -->
                        <StackPanel Spacing="8" IsVisible="{Binding IsImageSelected}">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Classes="sectionTitle" Text="IMAGE" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Classes="ghost" Content="Reset" Padding="8,3"
                                        Command="{Binding ResetImageAdjustmentsCommand}"
                                        IsVisible="{Binding ImageIsAdjusted}"
                                        ToolTip.Tip="Put every adjustment back to normal. The original picture was never altered, so nothing is lost." />
                            </Grid>

                            <Border Classes="card" Padding="6" HorizontalAlignment="Stretch">
                                <Image Source="{Binding ImagePreview}" Stretch="Uniform" MaxHeight="150"
                                       ToolTip.Tip="The picture as it will be engraved. Dark areas burn, light areas are skipped." />
                            </Border>

                            <CheckBox IsChecked="{Binding ImageInvert}" Content="Invert"
                                      ToolTip.Tip="Swap light and dark. Engraving burns the dark parts, so a picture meant to come out light-on-dark — slate, anodised aluminium, painted tile — needs this or it engraves as a negative." />

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBlock Grid.Column="0" Text="Brightness" Classes="label" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding ImageBrightness, StringFormat={}{0:0}}" Classes="readout" FontSize="13" />
                            </Grid>
                            <Slider Minimum="-100" Maximum="100" Value="{Binding ImageBrightness}" TickFrequency="1" IsSnapToTickEnabled="True"
                                    ToolTip.Tip="Lighten or darken the whole picture. Raise it if the engraving comes out too dark and muddy." />

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBlock Grid.Column="0" Text="Contrast" Classes="label" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding ImageContrast, StringFormat={}{0:0}}" Classes="readout" FontSize="13" />
                            </Grid>
                            <Slider Minimum="-100" Maximum="100" Value="{Binding ImageContrast}" TickFrequency="1" IsSnapToTickEnabled="True"
                                    ToolTip.Tip="Push the lights and darks apart. Wood and leather usually need more contrast than the photograph started with." />

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBlock Grid.Column="0" Text="Gamma" Classes="label" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding ImageGamma, StringFormat={}{0:0.00}}" Classes="readout" FontSize="13" />
                            </Grid>
                            <Slider Minimum="0.1" Maximum="3" Value="{Binding ImageGamma}" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                    ToolTip.Tip="Adjust the mid-tones without moving black or white. This is the control that rescues a face that has gone flat." />

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBlock Grid.Column="0" Text="Sharpen" Classes="label" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding ImageSharpen, StringFormat={}{0:0.00}}" Classes="readout" FontSize="13" />
                            </Grid>
                            <Slider Minimum="0" Maximum="2" Value="{Binding ImageSharpen}" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                    ToolTip.Tip="Bring out edges. A little helps almost every photograph, because the beam softens fine detail anyway." />

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBlock Grid.Column="0" Text="Skip lighter than" Classes="label" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding ImageWhiteClip, StringFormat={}{0:0}}" Classes="readout" FontSize="13" />
                            </Grid>
                            <Slider Minimum="0" Maximum="255" Value="{Binding ImageWhiteClip}" TickFrequency="1" IsSnapToTickEnabled="True"
                                    ToolTip.Tip="Anything this light is treated as blank and skipped entirely, which saves time and stops the laser faintly scorching what should stay clean. 255 skips nothing." />

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBlock Grid.Column="0" Text="Full power darker than" Classes="label" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding ImageBlackClip, StringFormat={}{0:0}}" Classes="readout" FontSize="13" />
                            </Grid>
                            <Slider Minimum="0" Maximum="255" Value="{Binding ImageBlackClip}" TickFrequency="1" IsSnapToTickEnabled="True"
                                    ToolTip.Tip="Anything this dark burns at full power. Raise it to deepen the blacks when an engraving looks washed out. 0 changes nothing." />

                            <TextBlock Text="Colour to grey" Classes="label" />
                            <ComboBox ItemsSource="{Binding GreyscaleModes}" SelectedItem="{Binding ImageGreyscaleMode}"
                                      HorizontalAlignment="Stretch"
                                      ToolTip.Tip="How colour is turned into brightness. Luma matches how the eye weights colours and suits photographs; the single-channel options can rescue artwork where one colour carries all the detail." />

                            <TextBlock Text="Dithering" Classes="label" Margin="0,4,0,0" />
                            <ComboBox ItemsSource="{Binding DitherKinds}" SelectedItem="{Binding SelectedDither}"
                                      HorizontalAlignment="Stretch"
                                      ToolTip.Tip="How shades of grey become laser pulses. At engraving speed the beam is nearly on-or-off, so the pattern used to fake the greys changes the result more than any other single setting.">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="raster:DitherInfo">
                                        <TextBlock Text="{Binding Label}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="{Binding DitherHint}" Classes="label" TextWrapping="Wrap"
                                       Foreground="{DynamicResource InkMuted}" />
                        </StackPanel>

                        <!-- Selection -->
                        <StackPanel Spacing="8">
                            <TextBlock Classes="sectionTitle" Text="SELECTION" />
                            <TextBlock Text="{Binding SelectionSummary}" Classes="mono" TextWrapping="Wrap" />

                            <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto"
                                  ColumnSpacing="8" RowSpacing="6"
                                  IsVisible="{Binding HasSelection}">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="X" Classes="label" VerticalAlignment="Center" />
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SelectedXMm, StringFormat={}{0:0.##}}" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Y" Classes="label" VerticalAlignment="Center" />
                                <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding SelectedYMm, StringFormat={}{0:0.##}}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="W" Classes="label" VerticalAlignment="Center" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedWidthMm, StringFormat={}{0:0.##}}"
                                         ToolTip.Tip="Width in millimetres. Typing one scales the selection to it." />
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="H" Classes="label" VerticalAlignment="Center" />
                                <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding SelectedHeightMm, StringFormat={}{0:0.##}}"
                                         ToolTip.Tip="Height in millimetres. Typing one scales the selection to it." />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Angle" Classes="label" VerticalAlignment="Center" />
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedRotationDeg, StringFormat={}{0:0.##}}"
                                         ToolTip.Tip="Rotation in degrees. This is the angle the selection ends up at, not an amount to turn it by — so typing 0 puts it back square. Dragging the round handle above the selection is the quick way; hold Shift while dragging to snap to fifteen degrees." />
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="°" Classes="label" VerticalAlignment="Center" />
                            </Grid>

                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                                <Button ToolTip.Tip="Move the selection to the middle of the bed." Grid.Column="0" Content="Centre" Command="{Binding CentreSelectedCommand}" />
                                <Button ToolTip.Tip="Turn the selection ninety degrees." Grid.Column="1" Content="Rotate" Command="{Binding RotateSelectedCommand}" CommandParameter="90" />
                                <Button ToolTip.Tip="Flip the selection over, like a mirror image." Grid.Column="2" Content="Mirror" Command="{Binding MirrorSelectedCommand}" CommandParameter="horizontal" />
                            </Grid>

                            <TextBlock Classes="sectionTitle" Text="ALIGN" Margin="0,4,0,0" />
                            <UniformGrid Rows="1" Columns="6">
                                <Button  ToolTip.Tip="Align left" Padding="0,5"
                                        Command="{Binding AlignSelectionCommand}" CommandParameter="Left" >
                                <PathIcon Data="{StaticResource IconAlignLeft}" Width="16" Height="16" />
                            </Button>
                                <Button  ToolTip.Tip="Centre horizontally" Padding="0,5"
                                        Command="{Binding AlignSelectionCommand}" CommandParameter="HorizontalCentre" >
                                <PathIcon Data="{StaticResource IconAlignCentreH}" Width="16" Height="16" />
                            </Button>
                                <Button  ToolTip.Tip="Align right" Padding="0,5"
                                        Command="{Binding AlignSelectionCommand}" CommandParameter="Right" >
                                <PathIcon Data="{StaticResource IconAlignRight}" Width="16" Height="16" />
                            </Button>
                                <Button  ToolTip.Tip="Align top" Padding="0,5"
                                        Command="{Binding AlignSelectionCommand}" CommandParameter="Top" >
                                <PathIcon Data="{StaticResource IconAlignTop}" Width="16" Height="16" />
                            </Button>
                                <Button  ToolTip.Tip="Centre vertically" Padding="0,5"
                                        Command="{Binding AlignSelectionCommand}" CommandParameter="VerticalCentre" >
                                <PathIcon Data="{StaticResource IconAlignCentreV}" Width="16" Height="16" />
                            </Button>
                                <Button  ToolTip.Tip="Align bottom" Padding="0,5"
                                        Command="{Binding AlignSelectionCommand}" CommandParameter="Bottom" >
                                <PathIcon Data="{StaticResource IconAlignBottom}" Width="16" Height="16" />
                            </Button>
                            </UniformGrid>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                <Button Grid.Column="0" Content="Spread across"
                                        ToolTip.Tip="Even the horizontal gaps (needs three or more)"
                                        Command="{Binding DistributeSelectionCommand}" CommandParameter="Horizontal" />
                                <Button ToolTip.Tip="Space the selected shapes evenly from top to bottom." Grid.Column="1" Content="Spread down"
                                        Command="{Binding DistributeSelectionCommand}" CommandParameter="Vertical" />
                            </Grid>

                            <!-- Two rows: four across a 300 px panel clips "Ungroup". -->
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="6" RowSpacing="6">
                                <Button ToolTip.Tip="Join the selected shapes so they move and scale as one." Grid.Row="0" Grid.Column="0" Content="Group" Command="{Binding GroupSelectionCommand}" />
                                <Button ToolTip.Tip="Split a group back into the shapes it was made from." Grid.Row="0" Grid.Column="1" Content="Ungroup" Command="{Binding UngroupSelectionCommand}" />
                                <Button ToolTip.Tip="Stop the selection being moved or changed by accident." Grid.Row="1" Grid.Column="0" Content="Lock" Command="{Binding ToggleLockSelectionCommand}" />
                                <Button ToolTip.Tip="Hide the selection on the canvas. Hidden shapes are not burned." Grid.Row="1" Grid.Column="1" Content="Hide" Command="{Binding ToggleVisibilitySelectionCommand}" />
                            </Grid>

                            <CheckBox Content="Snap to grid" IsChecked="{Binding SnapEnabled}"
                                      ToolTip.Tip="Hold Ctrl while dragging to bypass" />

                            <TextBlock Classes="sectionTitle" Text="ARRAY" Margin="0,4,0,0" />
                            <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" ColumnSpacing="6">
                                <TextBlock Grid.Column="0" Text="Cols" Classes="label" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding ArrayColumns}" />
                                <TextBlock Grid.Column="2" Text="Rows" Classes="label" VerticalAlignment="Center" />
                                <TextBox Grid.Column="3" Text="{Binding ArrayRows}" />
                                <TextBlock Grid.Column="4" Text="Gap" Classes="label" VerticalAlignment="Center" />
                                <TextBox Grid.Column="5" Text="{Binding ArraySpacingMm}" />
                            </Grid>
                            <Button ToolTip.Tip="Repeat the selection in a grid — useful for filling a sheet with copies of the same piece." Content="Create array" HorizontalAlignment="Stretch"
                                    Command="{Binding CreateArrayCommand}" />
                        </StackPanel>

                        <Separator />

                        <!-- Text -->
                        <StackPanel Spacing="8">
                            <TextBlock Classes="sectionTitle" Text="TEXT" />
                            <TextBox Text="{Binding TextInput}" AcceptsReturn="True" MinHeight="52"
                                     PlaceholderText="Type here, then press Add" />
                            <Grid ColumnDefinitions="*,Auto,70" ColumnSpacing="6">
                                <ComboBox ToolTip.Tip="Which typeface to use. Only fonts listed here can be turned into cuttable outlines." Grid.Column="0" ItemsSource="{Binding AvailableFonts}"
                                          SelectedItem="{Binding TextFont}" HorizontalAlignment="Stretch" />
                                <TextBlock Grid.Column="1" Text="mm" Classes="label" VerticalAlignment="Center" />
                                <TextBox Grid.Column="2" Text="{Binding TextSizeMm}" />
                            </Grid>
                            <CheckBox IsChecked="{Binding TextFilled}" Content="Filled"
                                      ToolTip.Tip="On: the letterforms are darkened, which is what engraved lettering usually means. Off: only their outlines are followed, for cutting letters out or scoring them. Letters are closed shapes, so this is a real choice rather than a detail." />
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                                <Button ToolTip.Tip="Add this text to the design. Filled or outline is set by the tick box above." Grid.Column="0" Content="Add" Command="{Binding AddTextCommand}" />
                                <Button ToolTip.Tip="Rebuild the selected text after changing its wording or font." Grid.Column="1" Content="Update" Command="{Binding RefreshTextCommand}"
                                        IsEnabled="{Binding IsTextSelected}" />
                                <Button Grid.Column="2" Content="To paths" Command="{Binding ConvertTextToPathsCommand}"
                                        IsEnabled="{Binding IsTextSelected}"
                                        ToolTip.Tip="Convert live text to outlines — no longer editable as text" />
                            </Grid>
                        </StackPanel>

                        <Separator />

                    </StackPanel>

                    <StackPanel Spacing="14" IsVisible="{Binding IsJobTab}">
                        <!-- Job summary -->
                        <StackPanel Spacing="6">
                            <TextBlock Classes="sectionTitle" Text="JOB" />
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="4">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Estimate" Classes="label" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding EstimateText}" Classes="mono" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Size" Classes="label" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding JobSizeText}" Classes="mono" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="G-code" Classes="label" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LineCountText}" Classes="mono" />
                            </Grid>

                            <Border Classes="card" IsVisible="{Binding IssueSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Text="{Binding IssueSummary}" TextWrapping="Wrap"
                                           FontSize="{DynamicResource FontSmall}" />
                            </Border>

                            <Button ToolTip.Tip="Save the job as a .nc file you can run from an SD card or another sender." Content="Export G-code" HorizontalAlignment="Stretch"
                                    Command="{Binding ExportGcodeCommand}" />
                        </StackPanel>
                    </StackPanel>

                    </Panel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- The two drawers share the bottom of the window. A stack keeps them
             clear of each other when both are open, which they often are while
             diagnosing something. -->
        <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Margin="12,0,352,12" Spacing="10">

        <!-- =============================== Assistant ================================== -->
        <Border Classes="panel slideUp" Height="360" Width="620"
                HorizontalAlignment="Left"
                IsVisible="{Binding ShowAssistant}" Padding="14">
            <DockPanel LastChildFill="True">

                <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="6" Margin="0,0,0,10">
                    <TextBlock Grid.Column="0" Classes="sectionTitle" Text="ASSISTANT" Margin="0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="thinking…" Classes="label" Margin="10,0,0,0"
                               VerticalAlignment="Center" IsVisible="{Binding Assistant.IsThinking}" />
                    <Button ToolTip.Tip="Stop the assistant answering." Grid.Column="2" Content="Stop" Classes="ghost" Padding="8,2"
                            IsVisible="{Binding Assistant.IsThinking}"
                            Command="{Binding Assistant.CancelCommand}" />
                    <Button ToolTip.Tip="Clear the conversation." Grid.Column="3" Content="Clear" Classes="ghost" Padding="8,2"
                            Command="{Binding Assistant.ClearCommand}" />
                    <Button ToolTip.Tip="Change or remove the Anthropic API key." Grid.Column="4" Content="Key"
                            Classes="ghost" Padding="8,2"
                            IsVisible="{Binding Assistant.HasStoredKey}"
                            Command="{Binding Assistant.ChangeKeyCommand}" />
                    <Button Grid.Column="5" Classes="ghost" Padding="6,2"
                            AutomationProperties.Name="Close the assistant"
                            Command="{Binding ToggleAssistantCommand}"
                            ToolTip.Tip="Close the assistant. The conversation is kept, so reopening carries on where you left off." >
                        <PathIcon Data="{StaticResource IconClose}" Width="13" Height="13" />
                    </Button>
                </Grid>

                <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,10,0,0">

                    <!-- Setting the key. Shown when there is not one, and reachable
                         afterwards from the Key button in the header. -->
                    <Border Classes="card" IsVisible="{Binding Assistant.ShowKeyEntry}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding Assistant.SetupHint}" TextWrapping="Wrap"
                                       FontSize="{DynamicResource FontSmall}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox Grid.Column="0" Text="{Binding Assistant.ApiKeyInput}"
                                         PasswordChar="•" PlaceholderText="sk-ant-…"
                                         ToolTip.Tip="Your Anthropic API key, from console.anthropic.com. It is written to a file only you can read, never into settings.json — that is the file people paste into forum posts when asking for help." />
                                <Button Grid.Column="1" Content="Save" Classes="primary"
                                        IsEnabled="{Binding Assistant.CanSaveKey}"
                                        Command="{Binding Assistant.SaveKeyCommand}"
                                        ToolTip.Tip="Store the key and switch the assistant on. No restart needed." />
                            </Grid>
                            <TextBlock Text="{Binding Assistant.KeyStatus}" Classes="label" TextWrapping="Wrap" />
                            <Button Content="Forget the saved key" Classes="ghost" HorizontalAlignment="Left"
                                    IsVisible="{Binding Assistant.HasStoredKey}"
                                    Command="{Binding Assistant.ForgetKeyCommand}"
                                    ToolTip.Tip="Delete the stored key from this computer. The assistant switches off; everything else keeps working." />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding Assistant.StatusMessage}" TextWrapping="Wrap"
                               Foreground="{DynamicResource StateHold}" FontSize="{DynamicResource FontSmall}"
                               IsVisible="{Binding Assistant.StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox Grid.Column="0" Text="{Binding Assistant.Input}"
                                 PlaceholderText="Ask about settings, a fault, or this job"
                                 KeyDown="OnAssistantKeyDown" />
                        <Button ToolTip.Tip="Ask the assistant. It can read your settings and suggest changes, but it can never move the machine itself." Grid.Column="1" Content="Ask" Classes="primary"
                                Command="{Binding Assistant.SendCommand}" />
                    </Grid>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10">

                        <!-- Safety gate: the assistant can put a card here, and nothing else. -->
                        <ItemsControl ItemsSource="{Binding Assistant.PendingActions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PendingActionViewModel">
                                    <Border Classes="card" Margin="0,0,0,6"
                                            BorderBrush="{DynamicResource EmberEdge}">
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="The assistant is asking permission" Classes="label" />
                                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button ToolTip.Tip="Apply the change the assistant is suggesting. Nothing has been sent to the machine until you press this." Grid.Column="1" Content="Do it" Classes="primary"
                                                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).Assistant.ConfirmActionCommand}"
                                                    CommandParameter="{Binding}" />
                                            <Button ToolTip.Tip="Dismiss the suggestion and change nothing." Grid.Column="2" Content="No" Classes="ghost"
                                                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).Assistant.DismissActionCommand}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Starting points, shown until the conversation begins. -->
                        <ItemsControl ItemsSource="{Binding Assistant.Suggestions}"
                                      IsVisible="{Binding !Assistant.Messages.Count}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Button ToolTip.Tip="Ask this question." Classes="ghost" HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left" Margin="0,0,0,4"
                                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).Assistant.UseSuggestionCommand}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource InkMuted}" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding Assistant.Messages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:AssistantMessage">
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="{Binding RoleLabel}" Classes="sectionTitle" Margin="0,0,0,2" />
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                                   Foreground="{Binding ColourKey, Converter={StaticResource ThemeBrush}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ============================== Simulation bar =============================== -->
        <Border Classes="panel slideUp" Padding="14,10"
                IsVisible="{Binding SimulationVisible}">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="12">
                <Button ToolTip.Tip="Play or pause the preview. This draws the toolpath on screen and moves nothing." Grid.Column="0" Classes="primary" Width="40" Padding="0"
                        Content="{Binding PlayPauseGlyph}"
                        Command="{Binding PlaySimulationCommand}" />
                <Button Grid.Column="1" Width="40" Padding="0" 
                        ToolTip.Tip="Stop and rewind"
                        Command="{Binding StopSimulationCommand}" >
                                <PathIcon Data="{StaticResource IconSquare}" Width="16" Height="16" />
                            </Button>

                <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SimulationStatus}" Classes="mono" FontSize="11" />
                    <Slider ToolTip.Tip="Scrub through the job to see the order things are burned in." Minimum="0" Maximum="1" Value="{Binding SimulationFraction}" />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="Speed" Classes="label" VerticalAlignment="Center" />
                    <ComboBox ToolTip.Tip="How fast the preview plays. It does not change the real job." ItemsSource="{Binding SimulationSpeeds}" SelectedItem="{Binding SimulationSpeed}"
                              MinWidth="76" />
                </StackPanel>

                <Button ToolTip.Tip="Close the preview." Grid.Column="4" Content="Close" Classes="ghost"
                        Command="{Binding StopSimulationCommand}" />
            </Grid>
        </Border>

        <!-- ============================== Console drawer =============================== -->
        <Border Classes="panel slideUp" Height="240"
                IsVisible="{Binding ShowConsole}" Padding="12">
            <DockPanel LastChildFill="True">
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6" Margin="0,0,0,8">
                    <TextBlock Grid.Column="0" Classes="sectionTitle" Text="MACHINE CONSOLE" Margin="0" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="Settings" Classes="ghost" Padding="8,2"
                            ToolTip.Tip="Open the controller settings editor"
                            Click="OnShowSettings" />
                    <Button ToolTip.Tip="Clear the console messages." Grid.Column="2" Content="Clear" Classes="ghost" Padding="8,2"
                            Command="{Binding Console.ClearCommand}" />
                    <Button Grid.Column="3" Classes="ghost" Padding="6,2"
                            AutomationProperties.Name="Close the console"
                            Command="{Binding ToggleConsoleCommand}"
                            ToolTip.Tip="Close the console. The log is kept." >
                        <PathIcon Data="{StaticResource IconClose}" Width="13" Height="13" />
                    </Button>
                </Grid>

                <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,8,0,0">
                    <TextBox Grid.Column="0" x:Name="ConsoleInput"
                             Text="{Binding Console.Input}"
                             PlaceholderText="Type a G-code or $ command and press Enter"
                             KeyDown="OnConsoleKeyDown" />
                    <Button ToolTip.Tip="Send this command to the machine exactly as typed. Only do this if you know what the command does." Grid.Column="1" Content="Send" Command="{Binding Console.SendCommand}" />
                </Grid>

                <ScrollViewer x:Name="ConsoleScroll" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Console.Lines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ConsoleLine">
                                <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                                    <TextBlock Grid.Column="0" Text="{Binding Stamp}" Classes="mono"
                                               FontSize="10" Foreground="{DynamicResource InkFaint}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Prefix}" Classes="mono"
                                               FontSize="10"
                                               Foreground="{Binding ColourKey, Converter={StaticResource ThemeBrush}}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Text}" Classes="mono"
                                               TextWrapping="Wrap"
                                               Foreground="{Binding ColourKey, Converter={StaticResource ThemeBrush}}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        </StackPanel>

        <!-- ============================== G-code panel ================================= -->
        <Border Grid.Row="1" Classes="panel focusIn" Width="520" Margin="12,12,0,0"
                HorizontalAlignment="Left" VerticalAlignment="Stretch"
                MaxHeight="620"
                IsVisible="{Binding ShowGcode}" Padding="14">
            <DockPanel LastChildFill="True">
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,8">
                    <TextBlock Grid.Column="0" Classes="sectionTitle" Text="G-CODE" Margin="0" VerticalAlignment="Center" />
                    <Button ToolTip.Tip="Copy the whole program to the clipboard." Grid.Column="1" Content="Copy" Classes="ghost" Padding="8,2"
                            Command="{Binding CopyGcodeCommand}" />
                    <Button ToolTip.Tip="Close the G-code view." Grid.Column="2" Content="Close" Classes="ghost" Padding="8,2"
                            Command="{Binding ToggleGcodeCommand}" />
                </Grid>

                <TextBlock DockPanel.Dock="Bottom" Text="{Binding GcodeSummary}" Classes="label"
                           TextWrapping="Wrap" Margin="0,8,0,0" />

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <SelectableTextBlock Text="{Binding GcodeText}" Classes="mono" FontSize="11" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- =============================== Status bar ================================== -->
        <!-- Along the bottom, where a status bar belongs. It used to run across the
             top, competing with the job actions for the most valuable strip on the
             screen — and readouts are glanced at, while the buttons beside them
             were pressed. -->
        <Border Grid.Row="2" Classes="panel focusInDelay1" Margin="12,12,12,12" Padding="14,8">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto">

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DocumentTitle}" VerticalAlignment="Center" FontWeight="Medium"
                               ToolTip.Tip="The design you are working on. A dot means there are changes that have not been saved." />
                    <Border Width="1" Background="{DynamicResource Hairline}" Margin="6,2" />
                    <Ellipse Width="10" Height="10"
                             Fill="{Binding StateColourKey, Converter={StaticResource ThemeBrush}}" />
                    <StackPanel>
                        <TextBlock Text="{Binding MachineStateName}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding StatusText}" Classes="label" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1" Width="1" Background="{DynamicResource Hairline}" Margin="16,2" />

                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,24,0">
                    <TextBlock Text="WORK" Classes="sectionTitle" Margin="0" />
                    <TextBlock Text="{Binding WorkPositionText}" Classes="readout" />
                </StackPanel>

                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,24,0">
                    <TextBlock Text="MACHINE" Classes="sectionTitle" Margin="0" />
                    <TextBlock Text="{Binding MachinePositionText}" Classes="mono"
                               Foreground="{DynamicResource InkMuted}" />
                </StackPanel>

                <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="0,0,24,0">
                    <TextBlock Text="FEED / POWER" Classes="sectionTitle" Margin="0" />
                    <TextBlock Text="{Binding FeedPowerText}" Classes="mono" />
                </StackPanel>

                <StackPanel Grid.Column="5" VerticalAlignment="Center">
                    <TextBlock Text="BUFFER" Classes="sectionTitle" Margin="0" />
                    <TextBlock Text="{Binding BufferText}" Classes="mono"
                               Foreground="{DynamicResource InkMuted}" />
                </StackPanel>

                <!-- Where the pointer is, which belongs beside the other coordinates
                     rather than floating over the canvas. -->
                <StackPanel Grid.Column="7" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="POINTER" Classes="sectionTitle" Margin="0" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding CursorText}" Classes="mono"
                               Foreground="{DynamicResource InkMuted}" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
