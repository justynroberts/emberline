<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>Emberline</AssemblyName>
    <RootNamespace>Emberline.App</RootNamespace>
    <ApplicationIcon>Assets/emberline.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />

    <!-- Also copied to disk, not only embedded: the headless self-test and any
         non-UI path runs before the Avalonia asset loader exists, and the text
         engine needs the file to register the family. -->
    <Content Include="Assets/Fonts/*.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>fonts/%(Filename)%(Extension)</Link>
    </Content>

    <!-- The Open Font License requires its text to travel with the fonts, so it
         ships beside them rather than only in the repository. -->
    <Content Include="Assets/Fonts/OFL.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>fonts/OFL.txt</Link>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Emberline.Core\Emberline.Core.csproj" />
    <ProjectReference Include="..\Emberline.GCode\Emberline.GCode.csproj" />
    <ProjectReference Include="..\Emberline.Cam\Emberline.Cam.csproj" />
    <ProjectReference Include="..\Emberline.Transport\Emberline.Transport.csproj" />
    <ProjectReference Include="..\Emberline.Devices\Emberline.Devices.csproj" />
    <ProjectReference Include="..\Emberline.Camera\Emberline.Camera.csproj" />
    <ProjectReference Include="..\Emberline.Catalog\Emberline.Catalog.csproj" />
    <ProjectReference Include="..\Emberline.Vision\Emberline.Vision.csproj" />
    <ProjectReference Include="..\Emberline.Materials\Emberline.Materials.csproj" />
    <ProjectReference Include="..\Emberline.VirtualLaser\Emberline.VirtualLaser.csproj" />
    <ProjectReference Include="..\Emberline.AI\Emberline.AI.csproj" />
    <ProjectReference Include="..\Emberline.Plugins\Emberline.Plugins.csproj" />
  </ItemGroup>
</Project>
